    {
      "id": "mgt-349",
      "type": "text",
      "x": 5996,
      "y": 674,
      "width": 443.09954833984375,
      "height": 600,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 15,
      "frameId": null,
      "groupIds": [],
      "index": "bQ1",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Decided by you:\n- descriptions: experience_id dropped (the\n  activity gives the experience); activities.master_id\n  dropped; first_offer_id dropped on descriptions and\n  cover_paragraphs; offer_lines.experience_id dropped;\n  experiences.sort_order (contract dates give the\n  order); contact.phone_link and website_link;\n  experiences.detail (repeats location);\n  experiences.company_label -> companies.name (json);\n  cover_paragraphs.default_order; companies.international\n  and country (never filled)\n- companies: kind dropped; contracts (new) hold\n  company, type, dates; experiences -> contract_id\n- offers: location_match dropped; location -> locations\n  table (a city, linked by id); french_version ->\n  english_mentioned: offer language not English and\n  English not mentioned -> a version in that language\n  (works for French, Arabic, ...); resume_url moves to\n  offers (one URL, cover inside); cover_letter_url dropped\n- every _en/_fr pair -> one json column {en, fr}\n- versions -> compositions; offer_id optional; folder\n  kept; dates: created_at, updated_at, sent_at\n  (composed_at, published_at dropped); template_sha kept\n- offer_results: set aside, to rethink later\n- requirements = offer + keyword + priority (int\n  0-100: 100 must-have, 0 preferred); no quote, section,\n  kind, description, targets, note, reviewed, overrides;\n  requirement_terms dropped\n- no previous-version link, no v1/v2 column\n- no compositions.language: a composition holds every\n  language; a missing translation is a warning\n- interview_notes: requirement_id is the key",
      "roughness": 1,
      "roundness": null,
      "seed": 265564798,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Decided by you:\n- descriptions: experience_id dropped (the\n  activity gives the experience); activities.master_id\n  dropped; first_offer_id dropped on descriptions and\n  cover_paragraphs; offer_lines.experience_id dropped;\n  experiences.sort_order (contract dates give the\n  order); contact.phone_link and website_link;\n  experiences.detail (repeats location);\n  experiences.company_label -> companies.name (json);\n  cover_paragraphs.default_order; companies.international\n  and country (never filled)\n- companies: kind dropped; contracts (new) hold\n  company, type, dates; experiences -> contract_id\n- offers: location_match dropped; location -> locations\n  table (a city, linked by id); french_version ->\n  english_mentioned: offer language not English and\n  English not mentioned -> a version in that language\n  (works for French, Arabic, ...); resume_url moves to\n  offers (one URL, cover inside); cover_letter_url dropped\n- every _en/_fr pair -> one json column {en, fr}\n- versions -> compositions; offer_id optional; folder\n  kept; dates: created_at, updated_at, sent_at\n  (composed_at, published_at dropped); template_sha kept\n- offer_results: set aside, to rethink later\n- requirements = offer + keyword + priority (int\n  0-100: 100 must-have, 0 preferred); no quote, section,\n  kind, description, targets, note, reviewed, overrides;\n  requirement_terms dropped\n- no previous-version link, no v1/v2 column\n- no compositions.language: a composition holds every\n  language; a missing translation is a warning\n- interview_notes: requirement_id is the key",
      "textAlign": "left",
      "updated": 1794590079017,
      "version": 1,
      "versionNonce": 1678005016,
      "verticalAlign": "top"
    },
