      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Resume score: the sum of every line's total (out of 8 ×\nlines), the rubric's resume-wide rule (Ready only when every\nincluded line is Ready), the average per criterion with the\nweakest first, and the claim–evidence counts. It is the\nexperience lines only, since they are the only blocs reviewed.",
      "roughness": 1,
      "roundness": null,
      "seed": 1963490300,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Resume score: the sum of every line's total (out of 8 ×\nlines), the rubric's resume-wide rule (Ready only when every\nincluded line is Ready), the average per criterion with the\nweakest first, and the claim–evidence counts. It is the\nexperience lines only, since they are the only blocs reviewed.",
      "textAlign": "left",
