      "index": "bKr",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Projects, education, languages, certifications have no line to\nscore: their keywords are the content. Each keyword is a chip:\ngreen = a skill your postings ask for (with how many jobs),\nblue = a known skill, dashed = not a skill yet, click + to add\nit (type it in the term drawer). In job reviews a term found\nin these sections already counts as met, like an experience\nline; the card at the top counts them too, kept apart from\n131/184.",
      "roughness": 1,
      "roundness": null,
      "seed": 185572476,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Projects, education, languages, certifications have no line to\nscore: their keywords are the content. Each keyword is a chip:\ngreen = a skill your postings ask for (with how many jobs),\nblue = a known skill, dashed = not a skill yet, click + to add\nit (type it in the term drawer). In job reviews a term found\nin these sections already counts as met, like an experience\nline; the card at the top counts them too, kept apart from\n131/184.",
      "textAlign": "left",
      "updated": 1794590079007,
      "version": 1,
      "versionNonce": 1708621124,
      "verticalAlign": "top"
