      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "A month with no experience between two jobs gets its own\ndashed bloc on the rail, so you notice a gap before an\nemployer does. Today there is one: Jul 2021, between MySchool\nand Lavish Trading.",
      "roughness": 1,
      "roundness": null,
      "seed": 143084412,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
